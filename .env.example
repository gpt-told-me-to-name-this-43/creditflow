# Alfa Smart Credit — пример конфигурации (docs/design.md v0.2).
# Скопируйте в .env и задайте свои значения. Реальные секреты не коммитить.
# Приложение ещё не реализовано: переменные описывают целевую конфигурацию.

# --- PostgreSQL ---
POSTGRES_DB=alfa_smart_credit
POSTGRES_USER=asc
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://asc:change-me@db:5432/alfa_smart_credit

# --- Backend / demo-auth (design §10.1) ---
APP_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=480
# Только для демо-стенда: включает GET /api/v1/auth/demo-accounts
DEMO_AUTH_ENABLED=true

# --- LLM (design §6.1) ---
# ollama | disabled. При disabled все LLM-задачи используют детерминированный fallback.
LLM_MODE=disabled
# Допустимы только локальные хосты: ollama, localhost, 127.0.0.1
LLM_BASE_URL=http://ollama:11434
# Конкретный checkpoint Qwen с открытыми весами фиксируется после выбора железа (design §14, вопрос 2)
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- Worker / jobs (design §6.4, §8.4) ---
JOB_MAX_ATTEMPTS=3
COUNTER_OFFER_TTL_HOURS=72

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
