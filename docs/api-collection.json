{
  "name": "CreditFlow API v1",
  "run": "make bru (scripts/bru_run.sh): reset clean → токены → bru run --env local",
  "environments": {
    "cloud": "vars {\n  baseUrl: https://creditflow.example/api/v1\n}\n\nvars:secret [\n  c1Token,\n  c2Token,\n  c3Token,\n  c4Token,\n  c5Token,\n  c6Token,\n  c7Token,\n  t1Token,\n  managerToken\n]\n",
    "local": "vars {\n  baseUrl: http://localhost:8080/api/v1\n}\n\nvars:secret [\n  c1Token,\n  c2Token,\n  c3Token,\n  c4Token,\n  c5Token,\n  c6Token,\n  c7Token,\n  t1Token,\n  managerToken\n]\n"
  },
  "folders": [
    {
      "name": "approve-sign-issue",
      "seq": 1,
      "requests": [
        {
          "name": "Создать черновик",
          "seq": 1,
          "method": "POST",
          "url": "{{baseUrl}}/applications",
          "auth": "{{c1Token}}",
          "body": "{}",
          "assert": {
            "res.status": "eq 201",
            "res.body.status": "eq DRAFT"
          },
          "script:post-response": "bru.setVar(\"appId\", res.body.id);\nbru.setVar(\"revision\", res.body.revision);"
        },
        {
          "name": "Заполнить условия",
          "seq": 2,
          "method": "PATCH",
          "url": "{{baseUrl}}/applications/{{appId}}",
          "auth": "{{c1Token}}",
          "body": "{\n  \"revision\": {{revision}},\n  \"purpose_code\": \"EQUIPMENT\",\n  \"requested_amount_rub\": 2000000,\n  \"term_months\": 36,\n  \"product_id\": \"investment\"\n}",
          "assert": {
            "res.status": "eq 200",
            "res.body.allowed_actions": "contains SUBMIT",
            "res.body.monthly_payment_rub": "eq \"78465.71\""
          },
          "script:post-response": "bru.setVar(\"revision\", res.body.revision);"
        },
        {
          "name": "Отправить",
          "seq": 3,
          "method": "POST",
          "url": "{{baseUrl}}/applications/{{appId}}/submit",
          "auth": "{{c1Token}}",
          "headers": {
            "Idempotency-Key": "{{idemKey}}"
          },
          "body": "{\n  \"revision\": {{revision}},\n  \"bki_consent_version\": \"bki-v1\"\n}",
          "assert": {
            "res.status": "eq 200",
            "res.body.status": "eq UNDER_REVIEW"
          },
          "script:pre-request": "bru.setVar(\"idemKey\", \"bru-\" + Date.now() + \"-\" + Math.floor(Math.random() * 1e9));",
          "script:post-response": "bru.setVar(\"revision\", res.body.revision);"
        },
        {
          "name": "Карточка менеджера",
          "seq": 4,
          "method": "GET",
          "url": "{{baseUrl}}/manager/applications/{{appId}}",
          "auth": "{{managerToken}}",
          "assert": {
            "res.status": "eq 200",
            "res.body.proposal.suggested_action": "eq ELIGIBLE_FOR_MANAGER_REVIEW",
            "res.body.scoring.dscr": "eq \"3.11\"",
            "res.body.scoring.score": "eq 100"
          },
          "script:post-response": "bru.setVar(\"revision\", res.body.revision);"
        },
        {
          "name": "Одобрить",
          "seq": 5,
          "method": "POST",
          "url": "{{baseUrl}}/manager/applications/{{appId}}/decisions",
          "auth": "{{managerToken}}",
          "headers": {
            "Idempotency-Key": "{{idemKey}}"
          },
          "body": "{\n  \"revision\": {{revision}},\n  \"action\": \"APPROVE\"\n}",
          "assert": {
            "res.status": "eq 201",
            "res.body.status": "eq APPROVED"
          },
          "script:pre-request": "bru.setVar(\"idemKey\", \"bru-\" + Date.now() + \"-\" + Math.floor(Math.random() * 1e9));",
          "script:post-response": "bru.setVar(\"revision\", res.body.revision);"
        },
        {
          "name": "Договор",
          "seq": 6,
          "method": "GET",
          "url": "{{baseUrl}}/applications/{{appId}}/contract",
          "auth": "{{c1Token}}",
          "assert": {
            "res.status": "eq 200",
            "res.body.status": "eq DRAFT",
            "res.body.amount_rub": "eq \"2000000.00\"",
            "res.body.monthly_payment_rub": "eq \"78465.71\""
          }
        },
        {
          "name": "Получить код подписания",
          "seq": 7,
          "method": "POST",
          "url": "{{baseUrl}}/applications/{{appId}}/sign/challenge",
          "auth": "{{c1Token}}",
          "body": "{\n  \"revision\": {{revision}}\n}",
          "assert": {
            "res.status": "eq 200",
            "res.body.attempts_remaining": "eq 3",
            "res.body.demo_code": "isString"
          },
          "script:post-response": "bru.setVar(\"revision\", res.body.revision);\nbru.setVar(\"challengeId\", res.body.challenge_id);\nbru.setVar(\"code\", res.body.demo_code);",
          "docs": "Простая электронная подпись: код показывается в UI (демо: вместо SMS)."
        },
        {
          "name": "Неверный код",
          "seq": 8,
          "method": "POST",
          "url": "{{baseUrl}}/applications/{{appId}}/sign",
          "auth": "{{c1Token}}",
          "headers": {
            "Idempotency-Key": "{{idemKey}}"
          },
          "body": "{\n  \"revision\": {{revision}},\n  \"challenge_id\": \"{{challengeId}}\",\n  \"code\": \"{{wrongCode}}\"\n}",
          "assert": {
            "res.status": "eq 422",
            "res.body.error.code": "eq SIGN_CODE_INVALID",
            "res.body.error.details.remaining_attempts": "eq 2"
          },
          "script:pre-request": "bru.setVar(\"idemKey\", \"bru-\" + Date.now() + \"-\" + Math.floor(Math.random() * 1e9));\nconst c = bru.getVar(\"code\");\nbru.setVar(\"wrongCode\", String((Number(c) + 1) % 1000000).padStart(6, \"0\"));"
        },
        {
          "name": "Подписать",
          "seq": 9,
          "method": "POST",
          "url": "{{baseUrl}}/applications/{{appId}}/sign",
          "auth": "{{c1Token}}",
          "headers": {
            "Idempotency-Key": "{{idemKey}}"
          },
          "body": "{\n  \"revision\": {{revision}},\n  \"challenge_id\": \"{{challengeId}}\",\n  \"code\": \"{{code}}\"\n}",
          "assert": {
            "res.status": "eq 200",
            "res.body.status": "eq SIGNED"
          },
          "script:pre-request": "bru.setVar(\"idemKey\", \"bru-\" + Date.now() + \"-\" + Math.floor(Math.random() * 1e9));",
          "script:post-response": "bru.setVar(\"revision\", res.body.revision);"
        },
        {
          "name": "Через 3–5 с — выдано",
          "seq": 10,
          "method": "GET",
          "url": "{{baseUrl}}/applications/{{appId}}",
          "auth": "{{c1Token}}",
          "assert": {
            "res.status": "eq 200",
            "res.body.status": "eq ISSUED"
          },
          "script:pre-request": "await bru.sleep(6000);"
        }
      ]
    },
