meta {
  name: Отправить
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/applications/{{appId}}/submit
  body: json
  auth: bearer
}

auth:bearer {
  token: {{t1Token}}
}

headers {
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "revision": {{revision}},
    "bki_consent_version": "bki-v1"
  }
}

assert {
  res.status: eq 503
  res.body.error.code: eq PROVIDER_UNAVAILABLE
}

script:pre-request {
  bru.setVar("idemKey", "bru-" + Date.now() + "-" + Math.floor(Math.random() * 1e9));
}
