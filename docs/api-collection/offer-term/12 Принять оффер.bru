meta {
  name: Принять оффер
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/applications/{{appId}}/offer/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{c2Token}}
}

headers {
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "revision": {{revision}}
  }
}

assert {
  res.status: eq 200
  res.body.status: eq APPROVED
}

script:pre-request {
  bru.setVar("idemKey", "bru-" + Date.now() + "-" + Math.floor(Math.random() * 1e9));
}

script:post-response {
  bru.setVar("revision", res.body.revision);
}
