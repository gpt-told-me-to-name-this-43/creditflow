meta {
  name: Оффер выше лимита
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/manager/applications/{{appId}}/decisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{managerToken}}
}

headers {
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "revision": {{revision}},
    "action": "COUNTER_OFFER",
    "amount_rub": 3300000,
    "term_months": 60,
    "client_reason_code": "HIGH_DEBT_LOAD",
    "comment": "Проверка лимита"
  }
}

assert {
  res.status: eq 422
  res.body.error.code: eq AMOUNT_ABOVE_LIMIT
}

script:pre-request {
  bru.setVar("idemKey", "bru-" + Date.now() + "-" + Math.floor(Math.random() * 1e9));
}
