meta {
  name: Чужая или несуществующая заявка
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/applications/00000000-0000-4000-8000-000000000000
  body: none
  auth: bearer
}

auth:bearer {
  token: {{c7Token}}
}

assert {
  res.status: eq 404
  res.body.error.code: eq NOT_FOUND
}

docs {
  Проверка полномочий руководителя при привязке (403 APPLICANT_NOT_AUTHORIZED) — #5.
}
