meta {
  name: Отправить с ключом
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/applications/{{appId}}/submit
  body: json
  auth: bearer
}

auth:bearer {
  token: {{c5Token}}
}

headers {
  Idempotency-Key: {{fixedKey}}
}

body:json {
  {
    "revision": {{revision}},
    "bki_consent_version": "bki-v1"
  }
}

assert {
  res.status: eq 200
  res.body.revision: eq 3
}

script:pre-request {
  bru.setVar("fixedKey", "bru-fixed-" + Date.now());
}
