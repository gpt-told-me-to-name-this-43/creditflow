meta {
  name: Встречное предложение по сумме
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/manager/applications/{{appId}}/decisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{managerToken}}
}

headers {
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "revision": {{revision}},
    "action": "COUNTER_OFFER",
    "amount_rub": 2340000,
    "client_reason_code": "HIGH_DEBT_LOAD",
    "comment": "Лимит на 36 мес. — 2 340 000"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq COUNTER_OFFER
}

script:pre-request {
  bru.setVar("idemKey", "bru-" + Date.now() + "-" + Math.floor(Math.random() * 1e9));
}

script:post-response {
  bru.setVar("revision", res.body.revision);
}
