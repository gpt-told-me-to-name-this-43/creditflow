meta {
  name: Предпросмотр 2340000 на 36
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/manager/applications/{{appId}}/offer-preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{managerToken}}
}

body:json {
  {
    "amount_rub": 2340000,
    "term_months": 36
  }
}

assert {
  res.status: eq 200
  res.body.valid: eq true
  res.body.monthly_payment_rub: eq "91804.88"
  res.body.score: eq 83
}
