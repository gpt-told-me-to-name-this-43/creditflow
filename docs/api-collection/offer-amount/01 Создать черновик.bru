meta {
  name: Создать черновик
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/applications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{c2Token}}
}

body:json {
  {}
}

assert {
  res.status: eq 201
  res.body.status: eq DRAFT
}

script:post-response {
  bru.setVar("appId", res.body.id);
  bru.setVar("revision", res.body.revision);
}
