meta {
  name: Договор
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/applications/{{appId}}/contract
  body: none
  auth: bearer
}

auth:bearer {
  token: {{c2Token}}
}

assert {
  res.status: eq 200
  res.body.amount_rub: eq "2340000.00"
  res.body.monthly_payment_rub: eq "91804.88"
  res.body.overpayment_rub: eq "964975.43"
}
