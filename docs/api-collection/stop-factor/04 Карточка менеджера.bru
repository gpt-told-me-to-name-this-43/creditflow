meta {
  name: Карточка менеджера
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/manager/applications/{{appId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{managerToken}}
}

assert {
  res.status: eq 200
  res.body.proposal.suggested_action: eq BLOCKED_BY_RULE
  res.body.proposal.blocking_codes: contains ACCOUNT_BLOCKED_BY_FNS
  res.body.allowed_actions.length: eq 1
  res.body.allowed_actions[0]: eq REJECT
}

script:post-response {
  bru.setVar("revision", res.body.revision);
}
