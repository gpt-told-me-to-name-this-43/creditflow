meta {
  name: Карточка менеджера
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/manager/applications/{{appId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{managerToken}}
}

assert {
  res.status: eq 200
  res.body.proposal.suggested_action: eq BLOCKED_BY_RULE
  res.body.scoring.calculation_status: eq SKIPPED
  res.body.ai_report.id: isString
  res.body.ai_report.status: isString
}

script:post-response {
  bru.setVar("revision", res.body.revision);
}
