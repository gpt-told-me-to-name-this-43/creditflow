meta {
  name: Встречное предложение
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/manager/applications/{{appId}}/decisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{managerToken}}
}

headers {
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "revision": {{revision}},
    "action": "COUNTER_OFFER",
    "amount_rub": 1500000,
    "client_reason_code": "LOW_SCORE",
    "comment": "Предлагаем меньшую сумму"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("idemKey", "bru-" + Date.now() + "-" + Math.floor(Math.random() * 1e9));
}

script:post-response {
  bru.setVar("revision", res.body.revision);
}
