meta {
  name: Отклонить оффер
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/applications/{{appId}}/offer/decline
  body: json
  auth: bearer
}

auth:bearer {
  token: {{c1Token}}
}

headers {
  Idempotency-Key: {{idemKey}}
}

body:json {
  {
    "revision": {{revision}}
  }
}

assert {
  res.status: eq 200
  res.body.status: eq DECLINED
}

script:pre-request {
  bru.setVar("idemKey", "bru-" + Date.now() + "-" + Math.floor(Math.random() * 1e9));
}
