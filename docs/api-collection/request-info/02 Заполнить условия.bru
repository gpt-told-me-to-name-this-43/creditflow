meta {
  name: Заполнить условия
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/applications/{{appId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{c3Token}}
}

body:json {
  {
    "revision": {{revision}},
    "purpose_code": "INVENTORY",
    "requested_amount_rub": 800000,
    "term_months": 12,
    "product_id": "working_capital"
  }
}

assert {
  res.status: eq 200
  res.body.allowed_actions: contains SUBMIT
}

script:post-response {
  bru.setVar("revision", res.body.revision);
}
