            }
          },
          {
            "description": "Задержка ответа, мс",
            "in": "header",
            "name": "x-sim-latency-ms",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 30000,
                  "minimum": 0,
